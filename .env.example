# 이 파일을 복사해 .env로 만들고 값을 채우세요 (.env는 git에 커밋되지 않습니다).
#   cp .env.example .env
#
# docker compose 스택(배포와 동일)에서는 아래 호스트 이름을 씁니다.
# 호스트에서 ./gradlew bootRun 할 때는 postgres → localhost, ai → localhost 로 바꾸세요.
DB_URL=jdbc:postgresql://postgres:5432/blocki
DB_USERNAME=blocki
DB_PASSWORD=blocki

# JWT 서명 비밀키. 최소 32바이트(256비트) 이상 필요합니다 (HS256).
#   openssl rand -base64 64
JWT_SECRET=

# OAuth callback 완료 후 이동할 프론트엔드 origin입니다.
FRONTEND_ORIGIN=http://localhost:5173

# Blocki OAuth 앱 자격증명. 유저 PAT이 아닙니다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/integrations/github/callback
GITHUB_SCOPE=read:user repo
GITHUB_AUTHORIZE_URI=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URI=https://github.com/login/oauth/access_token
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8080/api/v1/integrations/notion/callback
NOTION_AUTHORIZE_URI=https://api.notion.com/v1/oauth/authorize
NOTION_TOKEN_URI=https://api.notion.com/v1/oauth/token
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# 내부 Blocki-AI. INTERNAL_API_KEY와 같은 값이어야 합니다.
AI_BASE_URL=http://ai:8000/
AI_INTERNAL_KEY=
AI_TIMEOUT_SECONDS=300
