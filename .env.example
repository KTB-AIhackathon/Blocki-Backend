# 이 파일을 복사해 .env로 만들고 값을 채우세요 (.env는 git에 커밋되지 않습니다).
#   cp .env.example .env
#
# docker-compose.yml로 로컬 PostgreSQL을 띄운다면 DB_* 값은 아래 기본값 그대로 두면 됩니다.
# (application.yaml의 기본값과 동일하므로 사실 로컬 개발에서는 설정하지 않아도 동작합니다.)
DB_URL=jdbc:postgresql://localhost:5432/blocki
DB_USERNAME=blocki
DB_PASSWORD=blocki

# JWT 서명 비밀키. 최소 32바이트(256비트) 이상 필요합니다 (HS256).
# 로컬 개발용으로는 아래 명령으로 각자 생성해서 사용하세요. 팀원끼리 같은 값일 필요는 없습니다.
#   openssl rand -base64 64
#
# 배포 환경(EC2/RDS)의 실제 값은 GitHub Actions Secrets 또는 서버 환경변수로만 주입하고,
# 어떤 경우에도 git에 커밋하지 않습니다.
JWT_SECRET=

# OAuth callback 완료 후 이동할 프론트엔드 origin입니다.
FRONTEND_ORIGIN=http://localhost:5173

# GitHub·Notion OAuth 앱 설정입니다. 실제 비밀값은 커밋하지 않습니다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/integrations/github/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8080/api/v1/integrations/notion/callback
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# 내부 Blocki-AI 서비스 연결 설정. 두 값이 모두 있어야 문서 생성 워커가 활성화됩니다.
# 실제 내부 키는 절대 커밋하지 않습니다.
AI_BASE_URL=
AI_INTERNAL_KEY=
AI_TIMEOUT_SECONDS=30
